# Configuration inventory only: all values intentionally blank, no default credentials.
# Go does NOT load .env automatically. Supply process environment variables.
# Required by server; migrate needs only DB_*.
# Signs and verifies the HS256 bearer tokens issued at login. Never logged,
# never sent to the browser. Changing it invalidates every outstanding token.
TOKEN_SECRET=
# Database hostname; local development commonly uses 127.0.0.1.
DB_HOST=
# Integer 1-65535; MySQL normally uses 3306.
DB_PORT=
DB_NAME=
# Dedicated application account, not root.
DB_USER=
DB_PASSWORD=
# Optional: omitted or blank uses 127.0.0.1:8080.
HTTP_ADDR=

# Required by cmd/seed only, together with DB_*; never read by server/migrate.
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=

# Required by server and cmd/seed-materials: same absolute original-file directory.
# Planned Compose value: /data/uploads. No default.
UPLOAD_DIR=

# --- 可选：检索与问答的外部依赖 ---
# 以下全部可留空。留空时 api 仍能启动；问答会退化为只用 MySQL 关键字检索，
# 若连对话网关也没配置，POST /api/ask 会返回 503 而不是编造回答。密钥只在服务端使用。
# 向量库（Compose 内已提供，默认 http://qdrant:6333，可覆盖）。
QDRANT_URL=
QDRANT_COLLECTION=
# 嵌入网关：课程网关给出的 EMBEDDING_* 配置可原样填入，BASE_URL 写到 /v1 即可。
# 四项齐全（含维度）才会启用向量检索；DIM 不是请求参数，用于校验返回向量长度。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
# 对话网关：OpenAI 兼容的 /chat/completions，用于生成带 [n] 出处的简短回答。
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# --- 可选：外部工具（MCP） ---
# mcp 服务端自己的令牌：只从环境读取，不写入镜像与前端；留空时 /mcp 一律 401。
MCP_AUTH_TOKEN=
# api 侧的工具循环配额：缺省 10s / 3 轮 / 单轮 4 次。留空即默认值。
MCP_CALL_TIMEOUT=
MCP_MAX_ROUNDS=
MCP_MAX_CALLS=
# 可选：MCP 令牌加密子密钥。留空则由 TOKEN_SECRET 派生；换 TOKEN_SECRET 会让已存令牌解不开，
# 需要教师重新填写一次服务器令牌。
MCP_TOKEN_KEY=

# Compose only: MySQL initialization root password; never passed to the API.
MYSQL_ROOT_PASSWORD=
# Compose only: optional localhost Nginx port, default 8080.
CAMPUSCLAW_PORT=

# Fixed token and retrieval policy, NOT environment switches:
# Login token: HS256, 8 hours (28800 seconds), no sliding expiration, no server side session.
# Protected routes accept only Authorization: Bearer <token>; there is no session cookie and no CSRF token.
# Chunking: auto = 800 bytes with 80 bytes overlap; custom = 100-2000 bytes, overlap <= half; hierarchy by Markdown headings.
# Retrieval: vector candidates below cosine 0.35 are dropped; hybrid fuses ranks with RRF k = 60.
# Volumes: mysql_data -> /var/lib/mysql; material_data -> /data; qdrant_data -> /qdrant/storage.
# Files: /data/uploads; temporary files: /data/staging.
# Nginx must not mount material_data. See backend/CONFIGURATION.md and backend/SEARCH.md.
