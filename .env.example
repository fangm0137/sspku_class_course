# Configuration inventory only: all values intentionally blank, no default credentials.
# Go does NOT load .env automatically. Supply process environment variables.
# Required by server; migrate needs only DB_*.
# Signs and verifies the HS256 bearer tokens issued at login. Never logged,
# never sent to the browser. Changing it invalidates every outstanding token.
TOKEN_SECRET=
# Database hostname; local development commonly uses 127.0.0.1.
DB_HOST=
# Integer 1-65535; MySQL normally uses 3306.
DB_PORT=
DB_NAME=
# Dedicated application account, not root.
DB_USER=
DB_PASSWORD=
# Optional: omitted or blank uses 127.0.0.1:8080.
HTTP_ADDR=

# Required by cmd/seed only, together with DB_*; never read by server/migrate.
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=

# Required by server and cmd/seed-materials: same absolute original-file directory.
# Planned Compose value: /data/uploads. No default.
UPLOAD_DIR=

# Compose only: MySQL initialization root password; never passed to the API.
MYSQL_ROOT_PASSWORD=
# Compose only: optional localhost Nginx port, default 8080.
CAMPUSCLAW_PORT=

# Fixed session policy, NOT environment switches:
# Login session: 8 hours (28800 seconds), no sliding expiration.
# Anonymous session: 30 minutes (1800 seconds).
# CSRF: min(30 minutes, remaining session lifetime).
# Volumes: mysql_data -> /var/lib/mysql; material_data -> /data.
# Files: /data/uploads; temporary files: /data/staging.
# Nginx must not mount material_data. See backend/CONFIGURATION.md.
